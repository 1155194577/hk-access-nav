# Local secrets for the mobile app. Copy this file to `.env` and fill it in.
#
#     cp .env.example .env
#
# `.env` is gitignored. Never commit it: a published SiliconFlow key is a public
# key, billed to whoever owns the account, and scrapers find `sk-` strings on
# GitHub within minutes of a push.
#
# Restart the Expo dev server after changing this file — it is read when the
# bundler starts, not per request.
EXPO_PUBLIC_SILICONFLOW_API_KEY=
